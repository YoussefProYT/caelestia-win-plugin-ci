diff --git a/plugin/CMakeLists.txt b/plugin/CMakeLists.txt
index 6002d8b8..146f6bb3 100644
--- a/plugin/CMakeLists.txt
+++ b/plugin/CMakeLists.txt
@@ -1,13 +1,38 @@
-find_package(Qt6 REQUIRED COMPONENTS ShaderTools Core Qml Gui Quick QuickControls2 Concurrent Sql Network DBus Multimedia)
-find_package(PkgConfig REQUIRED)
-pkg_check_modules(Qalculate IMPORTED_TARGET libqalculate REQUIRED)
-pkg_check_modules(Pipewire IMPORTED_TARGET libpipewire-0.3 REQUIRED)
-pkg_check_modules(Aubio IMPORTED_TARGET aubio REQUIRED)
-pkg_check_modules(Cava IMPORTED_TARGET libcava QUIET)
-if(NOT Cava_FOUND)
-    pkg_check_modules(Cava IMPORTED_TARGET cava REQUIRED)
+find_package(Qt6 REQUIRED COMPONENTS ShaderTools Core Qml Gui Quick QuickControls2 Concurrent Sql Network Multimedia)
+if(NOT WIN32)
+    find_package(Qt6 REQUIRED COMPONENTS DBus)
+    find_package(PkgConfig REQUIRED)
+endif()
+
+if(WIN32)
+    set(CAELESTIA_NATIVE_DEFAULT OFF)
+else()
+    set(CAELESTIA_NATIVE_DEFAULT ON)
+endif()
+option(CAELESTIA_WITH_QALCULATE "Build the libqalculate-backed evaluator" ${CAELESTIA_NATIVE_DEFAULT})
+option(CAELESTIA_WITH_PIPEWIRE "Build the PipeWire audio collector" ${CAELESTIA_NATIVE_DEFAULT})
+option(CAELESTIA_WITH_AUBIO "Build the aubio beat tracker" ${CAELESTIA_NATIVE_DEFAULT})
+option(CAELESTIA_WITH_CAVA "Build the Cava visualiser" ${CAELESTIA_NATIVE_DEFAULT})
+option(CAELESTIA_WITH_SENSORS "Build the libsensors integration" ${CAELESTIA_NATIVE_DEFAULT})
+
+if(CAELESTIA_WITH_QALCULATE)
+    pkg_check_modules(Qalculate IMPORTED_TARGET libqalculate REQUIRED)
+endif()
+if(CAELESTIA_WITH_PIPEWIRE)
+    pkg_check_modules(Pipewire IMPORTED_TARGET libpipewire-0.3 REQUIRED)
+endif()
+if(CAELESTIA_WITH_AUBIO)
+    pkg_check_modules(Aubio IMPORTED_TARGET aubio REQUIRED)
+endif()
+if(CAELESTIA_WITH_CAVA)
+    pkg_check_modules(Cava IMPORTED_TARGET libcava QUIET)
+    if(NOT Cava_FOUND)
+        pkg_check_modules(Cava IMPORTED_TARGET cava REQUIRED)
+    endif()
+endif()
+if(CAELESTIA_WITH_SENSORS)
+    include(cmake/sensorslib.cmake)
 endif()
-include(cmake/sensorslib.cmake)
 
 set(QT_QML_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/qml")
 qt_standard_project_setup(REQUIRES 6.9)
