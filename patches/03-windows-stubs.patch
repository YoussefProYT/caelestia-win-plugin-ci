new file mode 100644
index 00000000..23580a2a
--- /dev/null
+++ b/plugin/src/Caelestia/Services/windows/sessionmanager.cpp
@@ -0,0 +1,31 @@
+#include "../sessionmanager.hpp"
+#include <qloggingcategory.h>
+
+namespace {
+Q_LOGGING_CATEGORY(lcSessionManager, "caelestia.services.sessionmanager", QtInfoMsg)
+bool powerAllowed() { return qEnvironmentVariableIntValue("CAELESTIA_WIN_ALLOW_POWER") == 1; }
+void logAction(const char* action) { qCInfo(lcSessionManager) << "Windows session action requested:" << action << "allowed:" << powerAllowed() << "(no action is executed by this port stub)"; }
+}
+namespace caelestia::shell::services {
+SessionManager::SessionManager(QObject* parent) : QObject(parent) {}
+bool SessionManager::exec(const QStringList& command) {
+    if (command.isEmpty()) return false;
+    const auto cmd = command.constFirst().toLower().remove(u'-').remove(u'_');
+    if (cmd == u"logout") { logout(); return true; }
+    if (cmd == u"suspend") { suspend(); return true; }
+    if (cmd == u"suspendthenhibernate") { suspendThenHibernate(); return true; }
+    if (cmd == u"hibernate") { hibernate(); return true; }
+    if (cmd == u"poweroff") { poweroff(); return true; }
+    if (cmd == u"reboot") { reboot(); return true; }
+    return false;
+}
+void SessionManager::logout() { logAction("logout"); }
+void SessionManager::suspend() { logAction("suspend"); }
+void SessionManager::suspendThenHibernate() { logAction("suspendThenHibernate"); }
+void SessionManager::hibernate() { logAction("hibernate"); }
+void SessionManager::poweroff() { logAction("poweroff"); }
+void SessionManager::reboot() { logAction("reboot"); }
+void SessionManager::handlePrepareForSleep(bool sleep) { if (sleep) emit aboutToSleep(); else emit resumed(); }
+void SessionManager::handleLockRequested() { emit lockRequested(); }
+void SessionManager::handleUnlockRequested() { emit unlockRequested(); }
+} // namespace caelestia::shell::services
